{
  "name": "stroma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check lint:shaders \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness",
    "lint:eslint": "eslint . --fix",
    "lint:shaders": "node scripts/check-shaders.mjs",
    "lint": "run-s lint:oxlint lint:eslint lint:shaders",
    "lint:check:oxlint": "oxlint . -D correctness",
    "lint:check:eslint": "eslint .",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint lint:shaders",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"scripts/**/*.mjs\" \"*.md\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ogl": "^1.0.11",
    "reka-ui": "2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "~1.83.0",
    "eslint-plugin-vue": "~10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.83.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  }
}
